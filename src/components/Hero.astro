---
import { FileTextIcon, MailIcon } from "@lucide/astro";
import { me } from "@/lib/constants";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import LinkButton from "./LinkButton.astro";

const facts = [
	{
		label: "Ubicación",
		value: me.location,
	},
	{
		label: "Enfoque",
		value: "Frontend + móvil",
	},
	{
		label: "Inglés",
		value: "C2 · Profesional",
	},
	{
		label: "Formación",
		value: `${me.education.degree} · ${me.education.status}`,
	},
];
---

<section class="container-page pt-14 pb-16 md:pt-24 md:pb-20">
	<p class="fade-rise flex items-center gap-2 font-mono text-xs text-muted">
		<span
			class="size-1.5 rounded-full bg-accent ring-4 ring-accent/15"
			aria-hidden="true"
		></span>
		{me.status}
	</p>

	<h1 class="mt-8 text-[clamp(3rem,7.5vw,7rem)] leading-[0.88] font-semibold tracking-[-0.055em]">
		<span class="hero-line">Alvaro</span>
		<span class="hero-line hero-line-delay">Resplandor</span>
	</h1>

	<div class="mt-10 grid gap-8 border-t border-rule pt-8 md:mt-12 md:pt-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start lg:gap-16">
		<div class="fade-rise fade-rise-delay">
			<p class="text-xl font-medium tracking-[-0.02em] md:text-2xl">
				Desarrollador de software
			</p>

			<p class="mt-4 max-w-[46ch] text-base text-muted md:text-lg">
				Construyo interfaces web y aplicaciones móviles con foco en claridad,
				rendimiento y detalle.
			</p>
		</div>

		<div class="fade-rise fade-rise-delay-2 flex flex-wrap items-center gap-3">
			<LinkButton href={`mailto:${me.email}`}>
				<MailIcon class="size-4" aria-hidden="true" />
				Escríbeme
			</LinkButton>

			<LinkButton
				href={me.resumeUrl}
				download="Alvaro Resplandor - CV"
				variant="outline"
			>
				<FileTextIcon class="size-4" aria-hidden="true" />
				Descargar CV
			</LinkButton>

			<div class="flex gap-3">
				<LinkButton
					href={me.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					variant="outline"
					icon
					title="LinkedIn"
					aria-label="LinkedIn"
				>
					<LinkedInIcon class="size-4" aria-hidden="true" />
				</LinkButton>

				<LinkButton
					href={me.github}
					target="_blank"
					rel="noopener noreferrer"
					variant="outline"
					icon
					title="GitHub"
					aria-label="GitHub"
				>
					<GithubIcon class="size-4" aria-hidden="true" />
				</LinkButton>
			</div>
		</div>
	</div>

	<dl class="mt-14 grid grid-cols-1 border-t border-rule sm:grid-cols-2 sm:gap-x-8 lg:mt-16 lg:grid-cols-4 lg:gap-x-0 lg:divide-x lg:divide-rule">
		{facts.map((fact) => (
			<div class="border-b border-rule py-5 lg:border-b-0 lg:px-6 lg:first:ps-0 lg:last:pe-0">
				<dt class="font-mono text-xs text-muted">{fact.label}</dt>
				<dd class="mt-2 text-sm leading-snug">{fact.value}</dd>
			</div>
		))}
	</dl>
</section>
