---
import { ArrowUpRightIcon, CodeIcon } from "@lucide/astro";
import { Image } from "astro:assets";
import type { Project } from "@/lib/types";
import LinkButton from "./LinkButton.astro";
import TechnologyLabel from "./TechnologyLabel.astro";

interface Props {
	project: Project;
}

const { project }: Props = Astro.props;
---

<article
	class="group grid gap-6 py-8 md:grid-cols-12 md:items-start md:gap-8 md:py-10"
	data-project-row
>
	<div class="md:col-span-8">
		<div class="flex flex-wrap items-center gap-3">
			<h3 class="text-2xl font-semibold tracking-[-0.02em] md:text-3xl">
				{project.title}
			</h3>

			{project.inReview && (
				<span class="inline-flex items-center gap-1.5 border border-rule px-2 py-1 font-mono text-[11px] text-muted">
					<span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
					En revisión
				</span>
			)}
		</div>

		<p class="mt-4 max-w-[58ch] text-base text-muted">{project.description}</p>

		<ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
			{project.technologies.map((technology) => (
				<li>
					<TechnologyLabel technology={technology} />
				</li>
			))}
		</ul>

		{(project.previewUrl || project.codeUrl) && (
			<div class="mt-6 flex flex-wrap gap-3">
				{project.previewUrl && (
					<LinkButton
						href={project.previewUrl}
						target="_blank"
						rel="noopener noreferrer"
						variant="outline"
						aria-label={`Ver sitio de ${project.title}`}
					>
						Ver sitio
						<ArrowUpRightIcon class="size-3.5" aria-hidden="true" />
					</LinkButton>
				)}

				{project.codeUrl && (
					<LinkButton
						href={project.codeUrl}
						target="_blank"
						rel="noopener noreferrer"
						variant="ghost"
						aria-label={`Ver código de ${project.title}`}
					>
						<CodeIcon class="size-3.5" aria-hidden="true" />
						Código
					</LinkButton>
				)}
			</div>
		)}
	</div>

	<div class="md:col-span-4">
		<div class="overflow-hidden border border-rule bg-paper-raised">
			<Image
				src={project.image}
				alt={`Captura de ${project.title}`}
				class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
				widths={[480, 800]}
				sizes="(min-width: 768px) 33vw, 100vw"
				loading="lazy"
			/>
		</div>
	</div>
</article>
