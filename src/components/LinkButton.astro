---
import { cn } from "@/lib/utils";

type Props = astroHTML.JSX.IntrinsicElements["a"] & {
	variant?: "primary" | "outline" | "ghost";
	icon?: boolean;
};

const {
	variant = "primary",
	icon = false,
	class: className,
	...props
} = Astro.props;

const themes: Record<NonNullable<Props["variant"]>, string> = {
	primary: "bg-accent text-accent-ink hover:bg-ink hover:text-paper",
	outline: "border border-rule text-ink hover:border-ink hover:bg-paper-raised",
	ghost: "text-muted hover:text-ink",
};

const theme = themes[variant];
---

<a
	class={cn(
		theme,
		"pressable inline-flex items-center justify-center gap-2 rounded-xs font-mono text-xs font-medium",
		icon ? "size-10 p-0" : "min-h-10 px-4 py-2.5",
		className,
	)}
	{...props}
>
	<slot />
</a>
