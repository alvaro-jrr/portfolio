---
import { ArrowUpRightIcon } from "@lucide/astro";
import { me } from "@/lib/constants";
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
	{
		label: "Trabajo",
		href: "/#work",
	},
	{
		label: "Experiencia",
		href: "/#experience",
	},
	{
		label: "Sobre mí",
		href: "/#about-me",
	},
];
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur-md">
	<div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
		<a
			href="/"
			class="flex items-center gap-3"
			aria-label="Alvaro Resplandor, inicio"
		>
			<span class="grid size-8 place-items-center rounded-xs border border-rule font-mono text-xs font-medium text-accent">
				AR
			</span>

			<span class="hidden text-sm font-semibold tracking-[-0.01em] sm:block">
				Alvaro Resplandor
			</span>
		</a>

		<div class="flex items-center gap-2 md:gap-6">
			<nav class="hidden items-center gap-6 md:flex" aria-label="Principal">
				{navLinks.map((link) => (
					<a
						href={link.href}
						class="link-underline font-mono text-xs text-muted transition-colors hover:text-ink"
					>
						{link.label}
					</a>
				))}
			</nav>

			<ThemeToggle />

			<a
				href={`mailto:${me.email}`}
				class="pressable inline-flex items-center gap-2 rounded-xs bg-accent px-3 py-2 font-mono text-xs font-medium text-accent-ink hover:bg-ink hover:text-paper"
			>
				Contacto
				<ArrowUpRightIcon class="size-3.5" aria-hidden="true" />
			</a>
		</div>
	</div>
</header>
