---
interface Props {
	meta?: string;
}

const { meta } = Astro.props;
---

<div class="mb-10 border-t border-rule pt-4 md:mb-14">
	<div class="flex flex-wrap items-baseline justify-between gap-3">
		<h2 class="text-3xl font-semibold tracking-[-0.015em] md:text-4xl">
			<slot />
		</h2>

		{meta && <span class="font-mono text-xs text-muted">{meta}</span>}
	</div>
</div>
