---
import { TECHNOLOGIES, type TechnologyId } from "@/lib/technologies";
import { cn } from "@/lib/utils";

interface Props {
	technology: TechnologyId;
	class?: string;
}

const { technology: technologyId, class: className } = Astro.props;

const technology = TECHNOLOGIES[technologyId];
const Icon = technology.icon;
---

<div
	class={cn(
		"inline-flex items-center gap-1.5 font-mono text-xs text-muted",
		className,
	)}
>
	{Icon ? <Icon class="size-3.5" aria-hidden="true" /> : null}

	<span>{technology.label}</span>
</div>
